NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical app URL used for OAuth redirect_to (no trailing slash).
# Local dev:  http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Skin Analysis (at least one required)
# Groq has priority if both are set (faster, more reliable uptime). Get key at https://console.groq.com
GROQ_API_KEY=
# Optional: override Groq model (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Gemini Vision AI alternative. Get key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional: override Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Real-time skin lesion detection (Roboflow Universe model skin-lesion-jxjgm/7)
# Get private key at https://app.roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=
